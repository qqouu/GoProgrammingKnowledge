```go
var v interface{} = "hello"

switch x := v.(type) {
case int:
    // 单一类型 case → x 的类型是 int
    fmt.Printf("x is int, value=%d\n", x+10)   // ✅ 可以直接算术运算
case string, bool:
    // 多类型 case → x 的类型是 interface{}
    fmt.Printf("x is interface{}, value=%v\n", x)
    // 下面这行编译错误：x 不是 string，不能直接调用 len
    // fmt.Println(len(x))
    
    // 需要自己再做一次类型断言
    if s, ok := x.(string); ok {
        fmt.Println("string length:", len(s))
    }
default:
    // x 的类型也是 interface{}
    fmt.Printf("unknown type: %T\n", x)
}
```

输出：
```
x is interface{}, value=hello
string length: 5
```

注意：`case string, bool` 中 `x` 不能直接调用 `len`，因为它是 `interface{}`。

